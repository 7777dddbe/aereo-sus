{
  "name": "canadair-cl415-sim",
  "version": "1.0.0",
  "description": "Simulatore 3D realistico del Canadair CL-415 antincendio nel browser (Three.js)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --loader:.png=dataurl --loader:.jpg=dataurl --loader:.bin=binary --outfile=dist/canadair.js",
    "dev": "esbuild src/main.js --bundle --sourcemap --format=iife --target=es2020 --loader:.png=dataurl --loader:.jpg=dataurl --loader:.bin=binary --outfile=dist/canadair.js --watch",
    "serve": "python3 -m http.server 8080",
    "test:physics": "node tools/sim-test.mjs",
    "garda": "NODE_USE_ENV_PROXY=1 node tools/garda/build-data.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7777dddbe/aereo-sus.git"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "geotiff": "^2.1.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "proj4": "^2.22.0",
    "three": "^0.186.1"
  }
}
